# Required
ANTHROPIC_API_KEY=your-api-key-here

# Ad Agent CLI models
DEFAULT_MODEL=claude-haiku-5-5
COMPLEX_MODEL=claude-sonnet-5-5
FFMPEG_PATH=ffmpeg
OUTPUT_DIR=output

# Studio pipeline models (defaults shown)
STUDIO_RESEARCH_MODEL=claude-opus-5-5
STUDIO_WRITER_MODEL=claude-opus-5-5
STUDIO_REVIEWER_MODEL=claude-opus-5-5
STUDIO_MAX_REVISIONS=2
STUDIO_FALLBACKS=1
STUDIO_TTS=kokoro
STUDIO_TTS_VOICE=am_michael

# Integrations: each runs live only when its values are set, otherwise writes a dry-run payload
SLACK_WEBHOOK_URL=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
NOTION_TOKEN=
NOTION_DATABASE_ID=
GOOGLE_DRIVE_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
